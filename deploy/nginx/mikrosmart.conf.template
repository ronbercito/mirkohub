# Archivo: deploy/nginx/mikrosmart.conf.template
# Función: Sitio Nginx del panel: sirve el frontend React compilado desde ${WEB_ROOT}
#          (con fallback a index.html para la SPA) y hace proxy inverso de /api/ hacia el
#          backend FastAPI en 127.0.0.1:8001. ${WEB_ROOT} lo reemplaza setup_debian.sh.
# Trabaja con: deploy/setup_debian.sh, deploy/supervisor/mikrosmart_backend.conf.template
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root ${WEB_ROOT};
    index index.html;

    client_max_body_size 20m;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8001/api/;
        proxy_http_version 1.1;
        proxy_read_timeout 120s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
